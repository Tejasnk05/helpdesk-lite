{
  "name": "helpdesk-lite",
  "version": "1.0.0",
  "description": "helpdesk-lite",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "knex": "tsx ./node_modules/knex/bin/cli.js --knexfile src/db/knexfile.ts",
    "migrate": "npm run knex -- migrate:latest",
    "migrate:rollback": "npm run knex -- migrate:rollback",
    "migrate:status": "npm run knex -- migrate:status",
    "migrate:make": "npm run knex -- migrate:make -x ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tejasnk05/helpdesk-lite.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Tejasnk05/helpdesk-lite/issues"
  },
  "homepage": "https://github.com/Tejasnk05/helpdesk-lite#readme",
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
